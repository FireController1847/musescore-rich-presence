{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure plugin",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "dev"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build plugin",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "dev"
            ],
            "dependsOn": "Configure plugin",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Install plugin (MuseScore user directory)",
            "dependsOn": "Build plugin",
            "problemMatcher": []
        },
        {
            "label": "Configure release",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "release"
            ],
            "problemMatcher": []
        },
        {
            "label": "Publish plugin",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "release"
            ],
            "dependsOn": "Configure release",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}
