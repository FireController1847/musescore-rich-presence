{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure plugin",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "dev"
            ],
            "problemMatcher": [],
            "windows": {
                "args": [
                    "--preset",
                    "dev-windows"
                ]
            }
        },
        {
            "label": "Build plugin",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "dev"
            ],
            "dependsOn": "Configure plugin",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "windows": {
                "args": [
                    "--build",
                    "--preset",
                    "dev-windows"
                ]
            }
        },
        {
            "label": "Install plugin (MuseScore user directory)",
            "dependsOn": "Build plugin",
            "problemMatcher": []
        },
        {
            "label": "Configure release",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "release"
            ],
            "problemMatcher": [],
            "windows": {
                "args": [
                    "--preset",
                    "release-windows"
                ]
            }
        },
        {
            "label": "Publish plugin",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "release"
            ],
            "dependsOn": "Configure release",
            "problemMatcher": [
                "$gcc"
            ],
            "windows": {
                "args": [
                    "--build",
                    "--preset",
                    "release-windows"
                ]
            }
        },
        {
            "label": "Configure Windows release (vcpkg)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--preset",
                "release-vcpkg"
            ],
            "problemMatcher": []
        },
        {
            "label": "Publish Windows release (vcpkg)",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "release-vcpkg"
            ],
            "dependsOn": "Configure Windows release (vcpkg)",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Install Windows Qt SDK",
            "type": "process",
            "command": "uvx",
            "args": [
                "--from",
                "aqtinstall",
                "aqt",
                "install-qt",
                "windows",
                "desktop",
                "6.10.2",
                "win64_msvc2022_64",
                "-O",
                "${env:USERPROFILE}/Qt"
            ],
            "problemMatcher": []
        },
        {
            "label": "Setup vcpkg",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/scripts/setup-vcpkg.ps1"
            ],
            "problemMatcher": []
        }
    ]
}
