{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "MuseScore Rich Presence",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist",
        "MUSESCORE_AUTO_DEPLOY": "ON"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "release",
      "displayName": "Publish release",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/release-${hostSystemName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "MUSESCORE_AUTO_DEPLOY": "OFF",
        "MUSESCORE_PACKAGE_RELEASE": "ON"
      }
    },
    {
      "name": "dev-windows",
      "displayName": "Develop on Windows (x64)",
      "inherits": "dev",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/dev-windows-x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": null,
        "CMAKE_CONFIGURATION_TYPES": "Release"
      }
    },
    {
      "name": "release-windows",
      "displayName": "Publish Windows release (x64)",
      "inherits": "dev-windows",
      "binaryDir": "${sourceDir}/build/release-windows-x64",
      "cacheVariables": {
        "MUSESCORE_AUTO_DEPLOY": "OFF",
        "MUSESCORE_PACKAGE_RELEASE": "ON"
      }
    },
    {
      "name": "dev-vcpkg",
      "displayName": "Develop on Windows (vcpkg)",
      "inherits": "dev-windows",
      "binaryDir": "${sourceDir}/build/dev-windows-x64-vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_APPLOCAL_DEPS": "OFF",
        "VCPKG_MANIFEST_MODE": "ON"
      }
    },
    {
      "name": "release-vcpkg",
      "displayName": "Publish Windows release (vcpkg)",
      "inherits": "release-windows",
      "binaryDir": "${sourceDir}/build/release-windows-x64-vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_APPLOCAL_DEPS": "OFF",
        "VCPKG_MANIFEST_MODE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "targets": [
        "publish"
      ]
    },
    {
      "name": "dev-windows",
      "configurePreset": "dev-windows",
      "configuration": "Release"
    },
    {
      "name": "release-windows",
      "configurePreset": "release-windows",
      "configuration": "Release",
      "targets": [
        "publish"
      ]
    },
    {
      "name": "dev-vcpkg",
      "configurePreset": "dev-vcpkg",
      "configuration": "Release"
    },
    {
      "name": "release-vcpkg",
      "configurePreset": "release-vcpkg",
      "configuration": "Release",
      "targets": [
        "publish"
      ]
    }
  ]
}
