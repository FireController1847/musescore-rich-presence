{
  "version": 3,
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "MuseScore Rich Presence",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/dist",
        "MUSESCORE_AUTO_DEPLOY": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Publish release",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/release-${hostSystemName}",
      "condition": {
        "type": "inList",
        "string": "${hostSystemName}",
        "list": [
          "Darwin",
          "Windows"
        ]
      },
      "cacheVariables": {
        "MUSESCORE_AUTO_DEPLOY": "OFF",
        "MUSESCORE_PACKAGE_RELEASE": "ON"
      }
    },
    {
      "name": "release-vcpkg",
      "displayName": "Publish Windows release (vcpkg)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/release-vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_APPLOCAL_DEPS": "OFF",
        "VCPKG_MANIFEST_MODE": "ON"
      }
    },
    {
      "name": "dev-vcpkg",
      "displayName": "Develop on Windows (vcpkg)",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/dev-vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_HOST_TRIPLET": "x64-windows",
        "VCPKG_APPLOCAL_DEPS": "OFF",
        "VCPKG_MANIFEST_MODE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "targets": [
        "publish"
      ]
    },
    {
      "name": "release-vcpkg",
      "configurePreset": "release-vcpkg",
      "targets": [
        "publish"
      ]
    },
    {
      "name": "dev-vcpkg",
      "configurePreset": "dev-vcpkg"
    }
  ]
}
