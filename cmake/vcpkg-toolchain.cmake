# Resolve vcpkg before project() without requiring VCPKG_ROOT in VS Code.
# An explicitly configured root takes precedence over automatic discovery.
set(_vcpkg_root "$ENV{VCPKG_ROOT}")
if(NOT _vcpkg_root STREQUAL "")
    if(NOT EXISTS "${_vcpkg_root}/scripts/buildsystems/vcpkg.cmake")
        message(FATAL_ERROR "VCPKG_ROOT points to an invalid vcpkg installation: ${_vcpkg_root}")
    endif()
else()
    foreach(_candidate "$ENV{USERPROFILE}/vcpkg" "$ENV{HOME}/vcpkg")
        if(EXISTS "${_candidate}/scripts/buildsystems/vcpkg.cmake")
            set(_vcpkg_root "${_candidate}")
            break()
        endif()
    endforeach()
    if(NOT _vcpkg_root)
        find_program(_vcpkg_exe NAMES vcpkg NO_CACHE)
        if(_vcpkg_exe)
            get_filename_component(_candidate "${_vcpkg_exe}" DIRECTORY)
            if(EXISTS "${_candidate}/scripts/buildsystems/vcpkg.cmake")
                set(_vcpkg_root "${_candidate}")
            endif()
        endif()
    endif()
    if(NOT _vcpkg_root)
        set(_vswhere "$ENV{ProgramFiles\(x86\)}/Microsoft Visual Studio/Installer/vswhere.exe")
        if(EXISTS "${_vswhere}")
            execute_process(COMMAND "${_vswhere}" -latest -products * -find "VC/vcpkg/scripts/buildsystems/vcpkg.cmake"
                OUTPUT_VARIABLE _vcpkg_toolchain OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(EXISTS "${_vcpkg_toolchain}")
                get_filename_component(_vcpkg_root "${_vcpkg_toolchain}/../../.." ABSOLUTE)
            endif()
        endif()
    endif()
endif()
if(NOT _vcpkg_root OR NOT EXISTS "${_vcpkg_root}/scripts/buildsystems/vcpkg.cmake")
    message(FATAL_ERROR "vcpkg not found. Run the VS Code Setup vcpkg task or set VCPKG_ROOT to an installed checkout.")
endif()
include("${_vcpkg_root}/scripts/buildsystems/vcpkg.cmake")
